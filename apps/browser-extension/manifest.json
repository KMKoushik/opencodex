{
  "manifest_version": 3,
  "name": "OpenCodex Browser Control",
  "version": "0.1.0",
  "description": "Pair your existing Chrome or Edge profile with OpenCodex browser tools.",
  "minimum_chrome_version": "120",
  "permissions": ["debugger", "scripting", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Connect OpenCodex" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src ws://127.0.0.1:* ws://[::1]:*"
  }
}
