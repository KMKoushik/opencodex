data: {"id":"evt_1a85210eb001g5Ay504vbPSKIn","created":1793825313003,"type":"session.reasoning.ended","location":{"directory":"/Users/demo/proj"},"data":{"sessionID":"ses_e57ae01feffec92hL50L241AGn","assistantMessageID":"msg_1a851fe35001dF2iK02CrQZsyY","ordinal":0,"text":"The user wants a 3-paragraph story about a lighthouse. Simple creative writing task. No tools needed.","native":{"reasoningField":"reasoning_content"}},"durable":{"aggregateID":"ses_e57ae01feffec92hL50L241AGn","seq":8,"version":1}}
