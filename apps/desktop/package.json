{
  "name": "@opencodex/desktop",
  "productName": "OpenCodex",
  "description": "An OpenCode workspace for desktop and web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/computer-use.mjs && electron-vite dev",
    "build": "node ../../scripts/computer-use.mjs && electron-vite build",
    "package": "bun run build && electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@electron/osx-sign": "^2.3.1",
    "@opencodex/contracts": "workspace:*",
    "@opencodex/gateway": "workspace:*",
    "@types/ws": "^8.18.2",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.4.5",
    "electron-builder": "^26.0.0",
    "electron-store": "^11.0.2",
    "electron-vite": "^5.0.0",
    "vite": "^7.1.0",
    "zod": "^4.1.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "ws": "^8.22.0"
  }
}
