{
  "name": "opencodex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n gateway,web 'bun run --cwd packages/gateway dev' 'bun run --cwd apps/web dev'",
    "dev:desktop": "concurrently -k -n gateway,desktop 'bun run --cwd packages/gateway dev' 'bun run --cwd apps/desktop dev'",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/desktop build",
    "build:web": "bun run --cwd apps/web build",
    "start": "bun run --cwd packages/gateway start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:smoke": "bun run build && playwright test",
    "check": "bun run plugins:check && bun run claude-code-plugin:check && bun run typecheck && bun run lint && bun run test && bun run build",
    "plugins": "node scripts/plugins.mjs",
    "plugins:check": "node scripts/plugins.mjs --check",
    "claude-code-plugin": "bun scripts/claude-code-plugin.mjs",
    "claude-code-plugin:check": "bun scripts/claude-code-plugin.mjs --check",
    "computer-use:build": "node scripts/computer-use.mjs",
    "computer-use:check": "node scripts/computer-use.mjs --check",
    "package:desktop": "bun run --cwd apps/desktop package",
    "architecture": "node scripts/architecture.mjs",
    "architecture:check": "node scripts/architecture.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.59.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "patchedDependencies": {
    "@khalilgharbaoui/opencode-claude-code-plugin@0.40.0": "patches/@khalilgharbaoui%2Fopencode-claude-code-plugin@0.40.0.patch"
  }
}
